				},
				{
					"name": "derivedColumn12"
				},
				{
					"name": "select6"
				},
				{
					"name": "select7"
				},
				{
					"name": "derivedColumn13"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn14"
				},
				{
					"name": "join5"
				},
				{
					"name": "join6"
				},
				{
					"name": "join7"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Order as short,",
				"          PID as long,",
				"          GarageType as string,",
				"          GarageYrBlt as short,",
				"          GarageFinish as string,",
				"          GarageCars as short,",
				"          GarageArea as short,",
				"          GarageQual as string,",
				"          GarageCond as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> GARAGE",
				"source(output(",
				"          PID as long,",
				"          BsmtQual as string,",
				"          BsmtCond as string,",
				"          BsmtExposure as string,",
				"          {BsmtFinType 1} as string,",
				"          BsmtFinSF1 as short,",
				"          BsmtFinType2 as string,",
				"          BsmtFinSF2 as short,",
				"          BsmtUnfSF as short,",
				"          TotalBsmtSF as short,",
				"          BsmtFullBath as short,",
				"          BsmtHalfBath as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> BSMT",
				"source(output(",
				"          PID as long,",
				"          PoolArea as short,",
				"          PoolQC as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> POOL",
				"source(output(",
				"          PID as integer,",
				"          MiscFeature as string,",
				"          MiscVal as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> MISC",
				"source(output(",
				"          PID as integer,",
				"          LotFrontage as double,",
				"          LotArea as integer,",
				"          Street as string,",
				"          Alley as string,",
				"          LotShape as string,",
				"          LandContour as string,",
				"          Utilities as string,",
				"          LotConfig as string,",
				"          LandSlope as string,",
				"          Neighborhood as string,",
				"          Condition1 as string,",
				"          Condition2 as string,",
				"          BldgType as string,",
				"          HouseStyle as string,",
				"          OverallQual as short,",
				"          OverallCond as short,",
				"          YearBuilt as short,",
				"          {YearRemod/Add} as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> BASE",
				"source(output(",
				"          ExterCond as string,",
				"          ExterQual as string,",
				"          {Heating QC} as string,",
				"          KitchenQual as string,",
				"          MSZoning as string,",
				"          Pid as integer,",
				"          RoofStyle as string,",
				"          RoofMatl as string,",
				"          Exterior1st as string,",
				"          Exterior2nd as string,",
				"          MasVnrType as string,",
				"          MasVnrArea as short,",
				"          Foundation as string,",
				"          Heating as string,",
				"          {Central Air} as string,",
				"          lectrical as string,",
				"          {1stFlrSF} as short,",
				"          {2ndFlrSF} as short,",
				"          LowQualFinSF as short,",
				"          {Kitchen AbvGr} as short,",
				"          TotRmsAbvGrd as short,",
				"          Functional as string,",
				"          Fireplaces as short,",
				"          FireplaceQu as string,",
				"          PavedDrive as string,",
				"          WoodDeckSF as short,",
				"          OpenPorchSF as short,",
				"          EnclosedPorch as short,",
				"          {3SsnPorch} as short,",
				"          ScreenPorch as short,",
				"          Fence as string,",
				"          MSSubClass as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> AMES",
				"source(output(",
				"          PID as integer,",
				"          Floor as boolean,",
				"          Bedrooms as short,",
				"          FullBath as short,",
				"          HalfBath as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> FLOOR",
				"source(output(",
				"          PID as string,",
				"          SaleDate as string,",
				"          SaleType as string,",
				"          SaleCondition as string,",
				"          salePrice as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SALE",
				"source(output(",
				"          Id as string,",
				"          Code as string,",
				"          Description as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TYPEQ",
				"source(output(",
				"          Id as string,",
				"          Description as string,",
				"          MSZoning as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> MSZONING",
				"GARAGE derive(PID = toString(toLong(PID))) ~> derivedColumn1",
				"BSMT derive(PID = toString(toLong(PID))) ~> derivedColumn2",
				"POOL derive(PID = toString(toLong(PID))) ~> derivedColumn3",
				"MISC derive(PID = toString(toLong(PID))) ~> derivedColumn4",
				"derivedColumn5, derivedColumn1 join(derivedColumn5@PID == derivedColumn1@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"BASE derive(PID = toString(toLong(PID))) ~> derivedColumn5",
				"join1, derivedColumn2 join(derivedColumn5@PID == derivedColumn2@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, derivedColumn3 join(derivedColumn5@PID == derivedColumn3@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3, derivedColumn4 join(derivedColumn5@PID == derivedColumn4@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"join7 select(skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(each(match(in(['GarageType','GarageFinish','GarageQual','GarageCond','BsmtQual','BsmtCond','BsmtExposure','BsmtFinType 1','BsmtFinType2','PoolQC','MiscFeature'],name)), $$ = iif(isNull($$) || trim(toString($$)) == '', 'NA', trim(toString($$)))),",
				"          each(match(in(['GarageYrBlt','GarageCars','GarageArea','BsmtFinSF1','BsmtFinSF2','BsmtUnfSF','TotalBsmtSF','BsmtFullBath','BsmtHalfBath','PoolArea','MiscVal'],name)), $$ = iif(isNull($$) || trim(toString($$)) == '', '0', trim(toString($$)))),",
				"          each(match(in(['RoofStyle','RoofMatl','Exterior1st','Exterior2nd','MasVnrType','Foundation','Heating','Central Air','lectrical','Functional','FireplaceQu','PavedDrive','Fence','ExterQual','ExterCond','Heating QC','KitchenQual','MSZoning','SaleType','SaleCondition'], name)), $$ = iif(isNull($$) || trim(toString($$)) == '', 'NA', trim(toString($$)))),",
				"          each(match(in(['MSSubClass','MasVnrArea','1stFlrSF','2ndFlrSF','LowQualFinSF','GrLivArea','Kitchen AbvGr','TotRmsAbvGrd','Fireplaces','WoodDeckSF','OpenPorchSF','EnclosedPorch','3SsnPorch','ScreenPorch','Bedrooms','FullBath','HalfBath','MoSold','YrSold','SalePrice'], name)), $$ = iif(isNull($$) || trim(toString($$)) == '', '0', trim(toString($$))))) ~> derivedColumn6",
				"AMES derive(PID = toString(toLong(Pid)),",
				"          {1stFlrSF} = toInteger(coalesce({1stFlrSF}, 0)),",
				"          {2ndFlrSF} = toInteger(coalesce({2ndFlrSF}, 0)),",
				"          LowQualFinSF = toInteger(coalesce(LowQualFinSF, 0)),",
				"          GrLivArea = toInteger(coalesce({1stFlrSF}, 0)) + toInteger(coalesce({2ndFlrSF}, 0)) + toInteger(coalesce(LowQualFinSF, 0))) ~> derivedColumn7",
				"derivedColumn7, TYPEQ lookup(ExterQual == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 derive(ExterQual_txt = toString(Code)) ~> derivedColumn8",
				"derivedColumn8 select(mapColumn(",
				"          ExterCond,",
				"          HeatingQC = {Heating QC},",
				"          KitchenQual,",
				"          MSZoning,",
				"          Pid = AMES@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir = {Central Air},",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr = {Kitchen AbvGr},",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = derivedColumn7@PID,",
				"          GrLivArea,",
				"          ExterQual = ExterQual_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, TYPEQ lookup(ExterCond == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup2",
				"lookup2 derive(ExterCond_txt = toString(Code)) ~> derivedColumn9",
				"derivedColumn9 select(mapColumn(",
				"          HeatingQC,",
				"          KitchenQual,",
				"          MSZoning,",
				"          Pid = select2@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = select2@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond = ExterCond_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3, TYPEQ lookup(HeatingQC == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup3",
				"lookup3 derive(HeatingQC_txt = toString(Code)) ~> derivedColumn10",
				"derivedColumn10 select(mapColumn(",
				"          KitchenQual,",
				"          MSZoning,",
				"          Pid = select3@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = select3@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond,",
				"          HeatingQC = HeatingQC_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4, TYPEQ lookup(KitchenQual == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup4",
				"lookup4 derive(KitchenQual_txt = toString(Code)) ~> derivedColumn11",
				"derivedColumn11 select(mapColumn(",
				"          MSZoning,",
				"          Pid = select4@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = select4@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond,",
				"          HeatingQC,",
				"          KitchenQual = KitchenQual_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"select5, select6 lookup(MSZoning == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup5",
				"lookup5 derive(MSZoning_txt = ZoneCode) ~> derivedColumn12",
				"MSZONING select(mapColumn(",
				"          Id,",
				"          Description,",
				"          ZoneCode = MSZoning",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"derivedColumn12 select(mapColumn(",
				"          Pid = select5@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = select5@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond,",
				"          HeatingQC,",
				"          KitchenQual,",
				"          MSZoning = MSZoning_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select7",
				"FLOOR derive(PID = toString(toLong(PID))) ~> derivedColumn13",
				"derivedColumn13 aggregate(groupBy(PID),",
				"     Bedrooms = sum(toInteger(Bedrooms)),",
				"          FullBath = sum(toInteger(FullBath)),",
				"          HalfBath = sum(toInteger(HalfBath))) ~> aggregate1",
				"SALE derive(PID = toString(toLong(PID)),",
				"          MoSold = month(toDate({SaleDate}, 'yyyy-MM-dd')),",
				"          YrSold = year(toDate({SaleDate}, 'yyyy-MM-dd'))) ~> derivedColumn14",
				"join4, select7 join(derivedColumn5@PID == select7@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join5",
				"join5, aggregate1 join(derivedColumn5@PID == aggregate1@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join6",
				"join6, derivedColumn14 join(derivedColumn5@PID == derivedColumn14@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join7",
				"derivedColumn6 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> frommongo"
			]
		}
	}
}