{
	"name": "NEON",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AmesDBTempdata",
						"type": "DatasetReference"
					},
					"name": "AMES"
				},
				{
					"dataset": {
						"referenceName": "FloorDetailData",
						"type": "DatasetReference"
					},
					"name": "FLOOR"
				},
				{
					"dataset": {
						"referenceName": "SalePropertyData",
						"type": "DatasetReference"
					},
					"name": "SALE"
				},
				{
					"dataset": {
						"referenceName": "TypequalityData",
						"type": "DatasetReference"
					},
					"name": "TYPEQ"
				},
				{
					"dataset": {
						"referenceName": "MszoningData",
						"type": "DatasetReference"
					},
					"name": "MSZONING"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "neon1",
						"type": "DatasetReference"
					},
					"name": "neon1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn7"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "derivedColumn8"
				},
				{
					"name": "select2"
				},
				{
					"name": "lookup2"
				},
				{
					"name": "derivedColumn9"
				},
				{
					"name": "select3"
				},
				{
					"name": "lookup3"
				},
				{
					"name": "derivedColumn10"
				},
				{
					"name": "select4"
				},
				{
					"name": "lookup4"
				},
				{
					"name": "derivedColumn11"
				},
				{
					"name": "select5"
				},
				{
					"name": "lookup5"
				},
				{
					"name": "derivedColumn12"
				},
				{
					"name": "select6"
				},
				{
					"name": "select7"
				},
				{
					"name": "derivedColumn13"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn14"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ExterCond as string,",
				"          ExterQual as string,",
				"          {Heating QC} as string,",
				"          KitchenQual as string,",
				"          MSZoning as string,",
				"          Pid as integer,",
				"          RoofStyle as string,",
				"          RoofMatl as string,",
				"          Exterior1st as string,",
				"          Exterior2nd as string,",
				"          MasVnrType as string,",
				"          MasVnrArea as short,",
				"          Foundation as string,",
				"          Heating as string,",
				"          {Central Air} as string,",
				"          lectrical as string,",
				"          {1stFlrSF} as short,",
				"          {2ndFlrSF} as short,",
				"          LowQualFinSF as short,",
				"          {Kitchen AbvGr} as short,",
				"          TotRmsAbvGrd as short,",
				"          Functional as string,",
				"          Fireplaces as short,",
				"          FireplaceQu as string,",
				"          PavedDrive as string,",
				"          WoodDeckSF as short,",
				"          OpenPorchSF as short,",
				"          EnclosedPorch as short,",
				"          {3SsnPorch} as short,",
				"          ScreenPorch as short,",
				"          Fence as string,",
				"          MSSubClass as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> AMES",
				"source(output(",
				"          PID as integer,",
				"          Floor as boolean,",
				"          Bedrooms as short,",
				"          FullBath as short,",
				"          HalfBath as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> FLOOR",
				"source(output(",
				"          PID as string,",
				"          SaleDate as string,",
				"          SaleType as string,",
				"          SaleCondition as string,",
				"          salePrice as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SALE",
				"source(output(",
				"          Id as string,",
				"          Code as string,",
				"          Description as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> TYPEQ",
				"source(output(",
				"          Id as string,",
				"          Description as string,",
				"          MSZoning as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> MSZONING",
				"AMES derive(PID = toString(toLong(Pid)),",
				"          {1stFlrSF} = toInteger(coalesce({1stFlrSF}, 0)),",
				"          {2ndFlrSF} = toInteger(coalesce({2ndFlrSF}, 0)),",
				"          LowQualFinSF = toInteger(coalesce(LowQualFinSF, 0)),",
				"          GrLivArea = toInteger(coalesce({1stFlrSF}, 0)) + toInteger(coalesce({2ndFlrSF}, 0)) + toInteger(coalesce(LowQualFinSF, 0)),",
				"          {Central Air} = iif(lower(toString({Central Air})) == 'true', 'Y', 'N')) ~> derivedColumn7",
				"derivedColumn7, TYPEQ lookup(ExterQual == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 derive(ExterQual_txt = toString(Code)) ~> derivedColumn8",
				"derivedColumn8 select(mapColumn(",
				"          ExterCond,",
				"          HeatingQC = {Heating QC},",
				"          KitchenQual,",
				"          MSZoning,",
				"          Pid = AMES@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir = {Central Air},",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr = {Kitchen AbvGr},",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = derivedColumn7@PID,",
				"          GrLivArea,",
				"          ExterQual = ExterQual_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, TYPEQ lookup(ExterCond == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup2",
				"lookup2 derive(ExterCond_txt = toString(Code)) ~> derivedColumn9",
				"derivedColumn9 select(mapColumn(",
				"          HeatingQC,",
				"          KitchenQual,",
				"          MSZoning,",
				"          Pid = select2@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = select2@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond = ExterCond_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3, TYPEQ lookup(HeatingQC == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup3",
				"lookup3 derive(HeatingQC_txt = toString(Code)) ~> derivedColumn10",
				"derivedColumn10 select(mapColumn(",
				"          KitchenQual,",
				"          MSZoning,",
				"          Pid = select3@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = select3@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond,",
				"          HeatingQC = HeatingQC_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4, TYPEQ lookup(KitchenQual == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup4",
				"lookup4 derive(KitchenQual_txt = toString(Code)) ~> derivedColumn11",
				"derivedColumn11 select(mapColumn(",
				"          MSZoning,",
				"          Pid = select4@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = select4@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond,",
				"          HeatingQC,",
				"          KitchenQual = KitchenQual_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"select5, select6 lookup(MSZoning == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup5",
				"lookup5 derive(MSZoning_txt = ZoneCode) ~> derivedColumn12",
				"MSZONING select(mapColumn(",
				"          Id,",
				"          Description,",
				"          ZoneCode = MSZoning",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"derivedColumn12 select(mapColumn(",
				"          Pid = select5@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = select5@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond,",
				"          HeatingQC,",
				"          KitchenQual,",
				"          MSZoning = MSZoning_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select7",
				"FLOOR derive(PID = toString(toLong(PID))) ~> derivedColumn13",
				"derivedColumn13 aggregate(groupBy(PID),",
				"     Bedrooms = sum(toInteger(Bedrooms)),",
				"          FullBath = sum(toInteger(FullBath)),",
				"          HalfBath = sum(toInteger(HalfBath))) ~> aggregate1",
				"SALE derive(PID = toString(toLong(PID)),",
				"          MoSold = month(toDate({SaleDate}, 'yyyy-MM-dd')),",
				"          YrSold = year(toDate({SaleDate}, 'yyyy-MM-dd'))) ~> derivedColumn14",
				"select7 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> neon1"
			]
		}
	}
}