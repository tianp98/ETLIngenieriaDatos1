{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AmespropertyData",
						"type": "DatasetReference"
					},
					"name": "AMESPROPERTY"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "pruebacsv",
						"type": "DatasetReference"
					},
					"name": "AmesPropertyPrep"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2",
					"description": "LotConfig, LandSlope, Neighborhood, Condition1, Condition2, BldgType, HouseStyle, OverallQual, OverallCond, YearBuilt, YearRemod/Add, Neighborhood, LF_med'"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          PID as long,",
				"          LotFrontage as double,",
				"          LotArea as long,",
				"          Street as string,",
				"          Alley as string,",
				"          LotShape as string,",
				"          LandContour as string,",
				"          Utilities as string,",
				"          LotConfig as string,",
				"          LandSlope as string,",
				"          Neighborhood as string,",
				"          Condition1 as string,",
				"          Condition2 as string,",
				"          BldgType as string,",
				"          HouseStyle as string,",
				"          OverallQual as long,",
				"          OverallCond as long,",
				"          YearBuilt as long,",
				"          {YearRemod/Add} as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> AMESPROPERTY",
				"derivedColumn3 derive(each(match(type=='string'), $$ = iif(isNull($$) || trim($$) == '', 'NA', $$)),",
				"          each(match(type=='integer'||type=='long'||type=='short'), $$ = iifNull($$, 0)),",
				"          each(match(type=='double'||type=='float'||type=='decimal'), $$ = iifNull($$, 0.0))) ~> derivedColumn1",
				"AMESPROPERTY aggregate(groupBy(Neighborhood),",
				"     LF_med = avg(LotFrontage)) ~> aggregate1",
				"AMESPROPERTY, aggregate1 join(AMESPROPERTY@Neighborhood == aggregate1@Neighborhood,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 derive(LotFrontage = iifNull(toDouble(LotFrontage), LF_med)) ~> derivedColumn2",
				"derivedColumn2 select(mapColumn(",
				"          PID,",
				"          LotFrontage,",
				"          LotArea,",
				"          Street,",
				"          Alley,",
				"          LotShape,",
				"          LandContour,",
				"          Utilities,",
				"          LotConfig,",
				"          LandSlope,",
				"          Neighborhood = AMESPROPERTY@Neighborhood,",
				"          Condition1,",
				"          Condition2,",
				"          BldgType,",
				"          HouseStyle,",
				"          OverallQual,",
				"          OverallCond,",
				"          YearBuilt,",
				"          {YearRemod/Add}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive({YearRemod/Add} = iif(isNull({YearRemod/Add}) || trim(toString({YearRemod/Add})) == '', toInteger({YearBuilt}), toInteger({YearRemod/Add}))) ~> derivedColumn3",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['amesproperty_clean.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1),",
				"     format: 'parquet') ~> AmesPropertyPrep"
			]
		}
	}
}